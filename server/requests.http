### server/requests.http  (WebStorm HTTP Client)
### Run schema.sql + seed.sql first so ids match the comments below.

@baseUrl = http://localhost:3000/api

### ---------- COURSES ----------

### GET all courses (200) -- each has a prerequisites array
GET {{baseUrl}}/courses

### GET one course (200) -- CSC4990 should show "prerequisites": [6, 7]
GET {{baseUrl}}/courses/10

### GET a course that does not exist (404)
GET {{baseUrl}}/courses/999

### POST a new course (201) -- becomes id 11 on a fresh seed
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CSC4600",
  "title": "Cloud Computing",
  "credits": 3,
  "description": "Test course",
  "prerequisites": [5, 9]
}

### POST with missing title (400)
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CSC4700",
  "credits": 3,
  "description": "Missing a title",
  "prerequisites": []
}

### POST with missing credits (400)
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "number": "CSC4700",
  "title": "No Credits",
  "prerequisites": []
}

### PUT update CSC3700 (id 7) to require CSC2200 and CSC3250 (200)
PUT {{baseUrl}}/courses/7
Content-Type: application/json

{
  "number": "CSC3700",
  "title": "Advanced Web Application Development",
  "credits": 3,
  "description": "React, Node/Express, MySQL, JWT authentication.",
  "prerequisites": [3, 5]
}

### PUT a course that does not exist (404)
PUT {{baseUrl}}/courses/999
Content-Type: application/json

{
  "number": "CSC9999",
  "title": "Ghost Course",
  "credits": 3,
  "description": "Does not exist",
  "prerequisites": []
}

### PUT with missing number (400)
PUT {{baseUrl}}/courses/7
Content-Type: application/json

{
  "title": "No Number",
  "credits": 3,
  "prerequisites": []
}

### DELETE the test course (200 + deleted course). Run the POST above first.
DELETE {{baseUrl}}/courses/11

### DELETE a course that does not exist (404)
DELETE {{baseUrl}}/courses/999

### ---------- COMPLETIONS ----------

### GET completed ids (200) -- seed gives [1, 3]
GET {{baseUrl}}/completions

### PUT a valid list (200) -- returns [1, 2, 3]
PUT {{baseUrl}}/completions
Content-Type: application/json

[1, 3, 2]

### PUT an empty list (200) -- nothing completed, returns []
PUT {{baseUrl}}/completions
Content-Type: application/json

[]

### PUT an INVALID list (400, nothing saved)
### CSC4990 (10) needs CSC3510 (6) and CSC3700 (7), which are not in the list
PUT {{baseUrl}}/completions
Content-Type: application/json

[1, 3, 10]

### PUT something that is not an array (400)
PUT {{baseUrl}}/completions
Content-Type: application/json

{ "completed": [1, 3] }

### GET again to prove the invalid PUT saved nothing (200)
GET {{baseUrl}}/completions
